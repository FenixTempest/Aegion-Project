:root{
    --BGC: burlywood;
    --font1:1.2rem "Fira Sans", sans-serif;
}

body{
    background-color: var(--BGC);
    font:var(--font1);
}

.menu1 {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    padding: 5px;
    gap: 10px;
}
.menu1 a{
    border-radius: 10px;
    background-color: goldenrod;
    color: black;
    padding: 10px 25px;
    text-decoration: none;
    border: 3px solid gold;
    
    /* configura las aanimacion del menu.
   - transition: anima transform (0.25s, curva cubic-bezier para un movimiento ágil),
     box-shadow y border-color (0.25s, easing suave).
   - will-change: indica al navegador que transform y box-shadow cambiarán 
   - transform-origin: center asegura que la escala se aplique desde el centro,
     manteniendo un efectoS simétrico. */
    transition: transform .25s cubic-bezier(.2,.9,.2,1), box-shadow .25s ease, border-color .25s ease;
    will-change: transform, box-shadow;
    transform-origin:center;



}

.menu1 a:hover{
    
    border-color: rgba(0,255,255,0.9);
    background-color: gold;  

    /* Eleva y amplía ligeramente el elemento y añade dos sombras:
   - primera sombra desplazada (profundidad)
   - segunda sombra centrada (brillo holográfico cyan) */
    transform: translateY(-6px) scale(1.04);
    box-shadow:
    0 14px 30px rgba(0,255,255,0.12), 
    0 0 14px rgba(0,255,255,0.30);     
}



@media(max-width: 746px){
    .menu1{
        flex-direction: column;
        align-items: flex-end;
    }
}
p{
    font-weight: bold;
    color: gainsboro;
    border-style: solid; 
}
